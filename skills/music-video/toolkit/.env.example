# Names of the environment variables the toolkit reads. Copy to .env and fill in; never commit the copy.
# Only hfapi.py reads a .env file itself (<workspace root>/.env, the folder that holds tools/). For every other
# variable, export it in the shell first, for example: set -a; . ./.env; set +a

# Higgsfield API key as <id>:<secret> (hfapi.py, and clips.py through it). Alternatively set HF_API_KEY_ID and HF_API_KEY_SECRET in .env.
HF_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Optional: the fraction of Seedance list price your Higgsfield account is charged (0.70 means 30% off). hfapi.py uses it
# for its estimates and ledger totals. Default 1.0. The billing page has the real figure.
HF_DISCOUNT=

# OpenRouter API key for imgedit.py edit, make and region.
OPENROUTER_API_KEY=

# Recraft API key for imgedit.py inpaint.
RECRAFT_API_KEY=

# Project folder for engine/render.py, relative to the workspace root (the folder that holds tools/ and engine/).
VIDEO_PROJECT=

# Optional: Whisper language code for the lips sync check in clips.py (en, es, ...); empty means auto-detect.
WHISPER_LANGUAGE=

# Optional: initial prompt for transcribe.py, names and unusual words in the lyric, to bias the transcript.
WHISPER_PROMPT=

# Optional: path to Chrome's DevToolsActivePort file for cdp.mjs; default is the macOS Google Chrome profile folder.
CHROME_DEVTOOLS_PORT_FILE=

# Optional: Python interpreter for tools/publish.sh; default is <workspace root>/.venv/bin/python, else python3.
PYTHON=
